# Where the Skills Directory app reads its catalog from.
# Copy this file to `.env.local` for local overrides (`.env.local` is gitignored).

# The registry repo that holds the skills (owner/repo).
SKILLS_REPO=miguel-leca-superside/superside-skills

# Which branch/tag/commit to read.
SKILLS_REPO_REF=main

# ---------------------------------------------------------------------------
# PRODUCTION (Vercel): set a token and the app fetches skills from GitHub at
# build/revalidate time ("fetch-at-build"). New skills appear on their own.
#
# Create a token with READ access to the private superside-skills repo:
#   GitHub → Settings → Developer settings → Fine-grained tokens →
#   Repository access: only superside-skills · Permissions: Contents = Read-only
# Then add it in Vercel → Project → Settings → Environment Variables as
# SKILLS_REPO_TOKEN. Do NOT commit a real token.
# ---------------------------------------------------------------------------
# SKILLS_REPO_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# LOCAL DEV: if no token is set, the app reads a local checkout of the registry
# instead (no token needed). Defaults to a sibling folder next to this app:
#   ../superside-skills
# Point it elsewhere if your checkout lives somewhere else.
# ---------------------------------------------------------------------------
# SKILLS_LOCAL_PATH=/absolute/path/to/superside-skills
